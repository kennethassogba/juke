{
  "openapi": "3.1.0",
  "info": {
    "title": "Play catalogue",
    "version": "1.0.0",
    "description": "Read-only game catalogue."
  },
  "servers": [
    {
      "url": "https://play.keff.uk"
    }
  ],
  "paths": {
    "/api/games": {
      "get": {
        "operationId": "searchGames",
        "summary": "Search games",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "games": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Game"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          }
        }
      }
    },
    "/api/games/{slug}": {
      "get": {
        "operationId": "getGame",
        "summary": "Get a game",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "juke",
                "harness-tycoon",
                "token-factory"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Game",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "404": {
            "description": "Unknown game"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Game": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "url",
          "details",
          "manifest",
          "controls",
          "features"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "details": {
            "type": "string",
            "format": "uri"
          },
          "manifest": {
            "type": "string",
            "format": "uri"
          },
          "icon": {
            "type": "string"
          },
          "art": {
            "type": "string"
          },
          "controls": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "offline": {
            "type": "boolean"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}