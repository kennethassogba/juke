{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juke-air-hockey",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "secrets": {
    "required": [
      "OPENAI_API_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "MAILING_LIST",
      "database_name": "keff-updates",
      "database_id": "82526bcf-d7a9-44b0-8da6-1a64e0b9ae39"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "IpRateLimiter"
      },
      {
        "name": "BROWSER_BUDGET",
        "class_name": "BrowserBudget"
      }
    ]
  },
  "routes": [
    {
      "pattern": "juke.keff.uk",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "exports": {
    "IpRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BrowserBudget": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
