{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juke-air-hockey",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "secrets": { "required": ["OPENAI_API_KEY"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "IpRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IpRateLimiter"] }
  ],
  "routes": [
    { "pattern": "juke.keff.uk", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
