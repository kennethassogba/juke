{
  "name": "juke-air-hockey",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run check && wrangler dev",
    "build": "node scripts/build.mjs",
    "check": "node --check src/worker.js && tsc --noEmit && npm run build",
    "deploy": "npm run check && wrangler deploy",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.150.0",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^26.6.4"
  },
  "dependencies": {
    "three": "^0.186.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@phosphor-icons/react": "^2.1.10"
  },
  "description": "Play: installable browser games by k_eff"
}
